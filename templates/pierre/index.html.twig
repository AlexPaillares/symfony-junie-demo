{% extends 'base.html.twig' %}

{% block title %}Paris → Antibes: Travel Alternatives{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="mb-3">Paris → Antibes: Travel Alternatives</h1>
    <p class="text-muted">High-level options including main highways and example fast-charger stops. Distances and times are indicative and depend on traffic, weather, and charging speed.</p>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Route</th>
                <th scope="col">Highways</th>
                <th scope="col">Distance (km)</th>
                <th scope="col">Est. Time</th>
                <th scope="col">Example Fast-Charger Stops</th>
                <th scope="col">Notes</th>
            </tr>
            </thead>
            <tbody>
            {% for alt in alternatives %}
                <tr>
                    <td><strong>{{ alt.name }}</strong></td>
                    <td>{{ alt.highways }}</td>
                    <td>{{ alt.distance_km }}</td>
                    <td>{{ alt.est_time }}</td>
                    <td>
                        <ul class="mb-0">
                            {% for c in alt.chargers %}
                                <li>{{ c.stop }} — <em>{{ c.network }}</em></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>{{ alt.notes }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <details class="mt-3">
        <summary>Notes and sources</summary>
        <ul>
            <li>Highway sequences (A6→A7→A8 and alternatives via A5/A31 and A75) are based on typical suggestions from major map providers.</li>
            <li>Charging networks shown (Ionity, TotalEnergies, Fastned, Izivia) operate HPC sites along French autoroutes; exact availability/power may vary.
                Always check the provider app or in-car navigation before traveling.</li>
        </ul>
    </details>
</div>
{% endblock %}

